<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/settings_container"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:context=".SettingsActivity"
	android:background="#0D1321">
	<LinearLayout
		android:id="@+id/settings_panes"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:baselineAligned="false">
		<LinearLayout
			android:id="@+id/pane_preview"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/header_layout"
				android:layout_width="match_parent"
				android:layout_height="60dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="14dp"
				android:paddingEnd="16dp">
				<ImageView
					android:id="@+id/button_back"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:src="@drawable/default_image"
					android:scaleType="center"
					android:contentDescription="Back" />
				<TextView
					android:id="@+id/tv_settings_title"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="SETTINGS"
					android:textSize="26sp"
					android:textColor="#FFD23F"
					android:layout_weight="1"
					android:layout_marginStart="14dp"
					android:maxLines="1"
					android:letterSpacing="0.06"
					android:fontFamily="@font/flappy_bold" />
			</LinearLayout>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/preview_card"
				android:layout_width="match_parent"
				android:layout_height="220dp"
				android:layout_marginTop="2dp"
				android:layout_marginBottom="6dp"
				app:cardBackgroundColor="#000000"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp"
				app:cardCornerRadius="28dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<FrameLayout
					android:id="@+id/live_preview_container"
					android:layout_width="match_parent"
					android:layout_height="match_parent" />
				<TextView
					android:id="@+id/preview_badge"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_margin="12dp"
					android:paddingTop="4dp"
					android:paddingBottom="4dp"
					android:background="#63D2E0"
					android:text="LIVE"
					android:textSize="11sp"
					android:textColor="#00363D"
					android:layout_gravity="top|start"
					android:paddingStart="10dp"
					android:paddingEnd="10dp"
					android:letterSpacing="0.1"
					android:fontFamily="@font/flappy_bold" />
				<TextView
					android:id="@+id/preview_caption"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_margin="12dp"
					android:paddingTop="7dp"
					android:paddingBottom="7dp"
					android:background="#0D1321"
					android:textSize="13sp"
					android:textColor="#E8ECF6"
					android:paddingStart="14dp"
					android:paddingEnd="14dp"
					android:alpha="0"
					android:maxLines="1"
					android:ellipsize="end"
					android:fontFamily="sans-serif-medium" />
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/pane_settings"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:orientation="vertical"
			android:layout_weight="1">
			<HorizontalScrollView
				android:id="@+id/category_scroll"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingStart="16dp"
				android:paddingEnd="10dp"
				android:clipToPadding="false"
				android:scrollbars="none">
				<LinearLayout
					android:id="@+id/category_bar"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="8dp"
					android:paddingBottom="8dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/tab_bird"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:background="#182134"
						android:gravity="center_horizontal|center_vertical"
						android:text="Bird"
						android:textSize="14sp"
						android:textColor="#A4AEC4"
						android:layout_marginEnd="6dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:maxLines="1"
						android:fontFamily="sans-serif-medium" />
					<TextView
						android:id="@+id/tab_world"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:background="#182134"
						android:gravity="center_horizontal|center_vertical"
						android:text="World"
						android:textSize="14sp"
						android:textColor="#A4AEC4"
						android:layout_marginEnd="6dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:maxLines="1"
						android:fontFamily="sans-serif-medium" />
					<TextView
						android:id="@+id/tab_pipes"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:background="#182134"
						android:gravity="center_horizontal|center_vertical"
						android:text="Pipes"
						android:textSize="14sp"
						android:textColor="#A4AEC4"
						android:layout_marginEnd="6dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:maxLines="1"
						android:fontFamily="sans-serif-medium" />
					<TextView
						android:id="@+id/tab_physics"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:background="#182134"
						android:gravity="center_horizontal|center_vertical"
						android:text="Physics"
						android:textSize="14sp"
						android:textColor="#A4AEC4"
						android:layout_marginEnd="6dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:maxLines="1"
						android:fontFamily="sans-serif-medium" />
					<TextView
						android:id="@+id/tab_effects"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:background="#182134"
						android:gravity="center_horizontal|center_vertical"
						android:text="Effects"
						android:textSize="14sp"
						android:textColor="#A4AEC4"
						android:layout_marginEnd="6dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:maxLines="1"
						android:fontFamily="sans-serif-medium" />
					<TextView
						android:id="@+id/tab_modes"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:background="#182134"
						android:gravity="center_horizontal|center_vertical"
						android:text="Modes"
						android:textSize="14sp"
						android:textColor="#A4AEC4"
						android:layout_marginEnd="6dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:maxLines="1"
						android:fontFamily="sans-serif-medium" />
					<TextView
						android:id="@+id/tab_system"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:background="#182134"
						android:gravity="center_horizontal|center_vertical"
						android:text="System"
						android:textSize="14sp"
						android:textColor="#A4AEC4"
						android:layout_marginEnd="6dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:maxLines="1"
						android:fontFamily="sans-serif-medium" />
					<TextView
						android:id="@+id/tab_presets"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:background="#182134"
						android:gravity="center_horizontal|center_vertical"
						android:text="Presets"
						android:textSize="14sp"
						android:textColor="#A4AEC4"
						android:layout_marginEnd="6dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:maxLines="1"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</HorizontalScrollView>
			<androidx.core.widget.NestedScrollView
				android:id="@+id/settings_scrollview"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:paddingBottom="28dp"
				android:layout_weight="1"
				android:clipToPadding="false"
				android:scrollbars="none">
				<FrameLayout
					android:id="@+id/settings_content_layout"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingStart="16dp"
					android:paddingEnd="16dp" />
			</androidx.core.widget.NestedScrollView>
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
